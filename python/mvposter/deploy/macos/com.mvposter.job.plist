<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent 模板：由 install.sh 把 __PROJECT_DIR__ 替换成实际路径后装到
     ~/Library/LaunchAgents/。必须装在用户会话（gui/<uid>）里：任务要连接用户
     手动启动的那只真实 Chrome（登录态在它的 profile 里）、还要持有 caffeinate
     防睡眠，daemon 会话下两样都拿不到。 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mvposter.job</string>

    <!-- 每天 03:00 跑一轮完整任务（检索 → 挑选 → 下载 → 发布）。
         改时刻就改这里的 Hour / Minute，再跑一次 install.sh。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/deploy/macos/run_job.sh</string>
    </array>

    <!-- 任务里有「上传视频 + 轮询转码 + 等页面反应」这类长等待，
         别让 App Nap 把它降级。 -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- 显式保持默认值 false：任务结束（含异常/被终止）时由 launchd 清掉同组的残留
         进程（caffeinate 等）。浏览器不在此列——它由 browserhost 常驻，脚本只连接它，
         不属于本任务的进程组，不会被这里清掉。 -->
    <key>AbandonProcessGroup</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/launchd.err.log</string>
</dict>
</plist>
