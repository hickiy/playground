<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent 模板：由 install.sh 把 __PROJECT_DIR__ 替换成实际路径后装到
     ~/Library/LaunchAgents/。必须装在用户会话（gui/<uid>）里：任务要连接用户
     手动启动的真实 Chrome、并持有 caffeinate 防睡眠，daemon 会话下都不行。 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jd.grab</string>

    <!-- 09:50 启动：脚本自己读参数，再等到 10:00:00 放库存开抢 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>50</integer>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/deploy/macos/run_grab.sh</string>
    </array>

    <!-- 避免 App Nap 把抢购这种「长时间等待 + 精确时刻」的任务降级 -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- 显式保持默认值 false：任务结束（含异常/被终止）时由 launchd 清掉同组的残留
         进程（caffeinate 等）。浏览器不在此列——它由用户手动启动并长期常驻，
         脚本只连接它，不属于本任务的进程组，不会被这里清掉。 -->
    <key>AbandonProcessGroup</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/launchd.err.log</string>
</dict>
</plist>
